# Copy to .env and adjust. docker-compose reads these defaults inline already;
# this file documents the knobs for tomorrow's tuning.
REDIS_URL=redis://redis:6379
ARENA_NETWORK=arena_net

# Telemetry scoring
TARGET_TPS=100000       # throughput (peak TPS) that earns the full throughput sub-score
LAT_REF_US=500          # p99 reference: latency_score = LAT_REF_US / (LAT_REF_US + p99_us)

# Load generator
BOTS_PER_WORKER=250     # async WS bots each bot_fleet replica spawns (closed phase)
INFLIGHT_WINDOW=32      # closed-loop in-flight window per bot (throughput phase)
SWEEP_RATES=5000,10000,20000,40000,80000  # open-loop offered-load sweep (ord/s/worker)
STEP_SECS=4             # seconds per sweep step
SWEEP_BOTS=120          # bot pool size during the sweep
SUSTAIN_RATIO=0.9       # achieved/offered threshold to count a load as "sustained" (telemetry)

# Sandbox resource limits (applied by orchestrator/sandbox.py)
SANDBOX_CPUS=2.0
SANDBOX_MEMORY=512m
SANDBOX_CPUSET=0,1      # CPU pinning
SANDBOX_PIDS=256
